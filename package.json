{
  "name": "illora-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/agent-postbuild.mjs",
    "start": "next start",
    "lint": "eslint",
    "agent:send": "node scripts/agent-bridge.mjs send",
    "agent:inbox": "node scripts/agent-bridge.mjs inbox",
    "agent:thread": "node scripts/agent-bridge.mjs thread",
    "agents:cycle": "powershell -ExecutionPolicy Bypass -File scripts/agent-review-cycle.ps1",
    "agents:watch": "powershell -ExecutionPolicy Bypass -File scripts/agent-watch.ps1",
    "agents:watch:start": "powershell -ExecutionPolicy Bypass -File scripts/start-agent-watch.ps1",
    "agents:watch:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-agent-watch.ps1",
    "agents:hooks:install": "powershell -ExecutionPolicy Bypass -File scripts/install-agent-hooks.ps1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env --import tsx src/server/db/seed.ts",
    "db:seed-applications": "node --env-file=.env --import tsx src/server/db/seed-applications.ts",
    "db:seed-content": "node --env-file=.env --import tsx src/server/db/seed-content.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.10.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
