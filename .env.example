# Supabase Postgres connection string (Session pooler recommended for serverless/Vercel)
DATABASE_URL=

# Resend — one verified sending address reused for all transactional mail
# (job alerts, CV/vacancy/contact confirmations)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared secret checked by the job alerts cron route handler
JOB_ALERTS_CRON_SECRET=

# HMAC secret for campaign unsubscribe links (/admin/campaigns). Any long
# random string; rotating it invalidates unsubscribe links in already-sent
# emails.
CAMPAIGN_UNSUBSCRIBE_SECRET=

NEXT_PUBLIC_SITE_URL=

# Supabase Auth — Project Settings -> API in the Supabase dashboard.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the anon/public (or "publishable") key,
# safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role (or "secret") key — bypasses all Row Level Security. Server-only,
# never expose to the client. Used only by the admin "total accounts" stat.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of account emails allowed to access /admin
ADMIN_EMAILS=

# Optional: comma-separated domains whose signed-in users should be treated as
# admins. Defaults to illouraservices.com when left blank.
ADMIN_DOMAINS=

# Google Gemini API key for the admin AI assistant (/admin/assistant)
# Get one free (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: connection string for a read-only Postgres role, strongly
# recommended for the admin AI assistant's SQL tool (see
# src/server/integrations/gemini.ts). Falls back to DATABASE_URL with a
# loud warning if unset — the regex-based SQL validator is defense-in-depth
# only, not a substitute for DB-level read-only permissions.
ADMIN_ASSISTANT_DATABASE_URL=

# Supabase Storage (resume/cover-letter uploads, campaign attachments) —
# S3-compatible endpoint. Generate the access key pair in the Supabase
# dashboard: Project Settings -> Storage -> S3 Connection. All five are
# required — src/server/integrations/supabase-storage.ts throws on import
# if any are missing.
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET_NAME=

# Signing secret for the Supabase Auth "Send Email" hook
# (src/app/api/auth/send-email/route.ts), which sends auth emails via Resend's
# HTTP API instead of Supabase's built-in SMTP relay. Configure the hook in
# Supabase Dashboard -> Authentication -> Hooks -> "Send Email", pointed at
# this route's public URL — Supabase generates this secret (format
# "v1,whsec_...") when you save the hook; paste it here. Requests without a
# valid signature are rejected with 401 (src/server/auth/verify-webhook.ts).
SEND_EMAIL_HOOK_SECRET=
